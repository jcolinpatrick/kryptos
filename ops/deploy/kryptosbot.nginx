# --- Rate limiting zones (shared memory) ---
# Per-IP: 10 req/s burst 20 (normal browsing ≈ 2-5 req/s)
limit_req_zone  $binary_remote_addr  zone=perip:10m   rate=10r/s;
# API is the only dynamic surface. Keep it materially tighter than static pages.
limit_req_zone  $binary_remote_addr  zone=api_perip:10m   rate=3r/s;
# Server-wide: 200 req/s — caps total load regardless of source count
limit_req_zone  $server_name         zone=global:1m    rate=200r/s;
# Per-IP connection cap
limit_conn_zone $binary_remote_addr  zone=connperip:10m;

# HTTP → HTTPS redirect
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name kryptosbot.com www.kryptosbot.com;

    return 301 https://$host$request_uri;
}

# HTTPS server
server {
    listen 443 ssl http2 default_server;
    listen [::]:443 ssl http2 default_server;
    server_name kryptosbot.com www.kryptosbot.com;

    ssl_certificate     /etc/letsencrypt/live/kryptosbot.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/kryptosbot.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    server_tokens off;

    root /home/cpatrick/kryptos/site;
    index index.html;

    # Static site accepts no uploads — keep body tiny everywhere
    client_max_body_size 1k;
    client_body_timeout 10s;
    client_header_timeout 10s;

    # --- Gzip compression ---
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;

    # --- Only allow safe HTTP methods ---
    if ($request_method !~ ^(GET|HEAD|POST|OPTIONS)$) {
        return 405;
    }

    # --- Rate & connection limits ---
    limit_req   zone=perip   burst=20 nodelay;
    limit_req   zone=global  burst=50 nodelay;
    limit_conn  connperip    30;
    limit_req_status  429;
    limit_conn_status 429;

    # --- Security headers ---
    add_header X-Content-Type-Options    "nosniff"          always;
    add_header X-Frame-Options           "DENY"             always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy        "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy   "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://ntfy.sh; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;

    # --- Security: deny access to databases, dotfiles, and common exploit paths ---
    location ~* \.sqlite$ { deny all; return 404; }
    location ^~ /db/          { deny all; return 404; }
    location ~ /\.            { deny all; return 404; }

    # Drop obvious exploit-path families early. These do not correspond to any
    # real KryptosBot routes and dominated hostile scan traffic in April 2026.
    location ~* ^/(?:wp-(?:admin|content|includes)|wordpress(?:/|$)|xmlrpc\.php|admin(?:/|$)|cgi-bin(?:/|$)|phpmyadmin(?:/|$)|adminer(?:/|$)|setup(?:/|$)|install(?:/|$)|backup(?:/|$)|backups(?:/|$)|old(?:/|$)|new(?:/|$)|webui(?:/|$)|geoserver(?:/|$)|\.env|server\.js|secrets\.yaml|html\.tgz$|license\.txt$) {
        return 404;
        access_log off;
    }

    # Serve favicon with long cache
    location = /favicon.ico {
        expires 30d;
        add_header Cache-Control "public, immutable" always;
        access_log off;
    }

    # Drop common exploit probes early (before try_files wastes I/O)
    location ~* \.(php|asp|aspx|jsp|cgi)$ {
        return 404;
        access_log off;
    }

    # --- API reverse proxy ---
    location /api/ {
        # Only allow methods the API actually uses
        limit_except GET POST {
            deny all;
        }

        # Dynamic surface: tighter per-IP rate limit and lower burst tolerance
        # than the static site.
        limit_req zone=api_perip burst=8 nodelay;

        proxy_pass http://127.0.0.1:8321;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Limit request body to 8 KB (theory text max ~2 KB + JSON overhead)
        client_max_body_size 8k;

        # Timeouts — classification calls Claude, allow up to 30s
        proxy_read_timeout 30s;
        proxy_send_timeout 10s;
    }

    # --- Traffic stats (password-protected) ---
    # GoAccess reports are self-contained HTML (inline JS with eval(), inline CSS,
    # base64 fonts). Behind basic auth — no CSP needed.
    location ^~ /stats/ {
        auth_basic "Stats";
        auth_basic_user_file /etc/nginx/.htpasswd_stats;

        add_header X-Content-Type-Options    "nosniff"          always;
        add_header X-Frame-Options           "DENY"             always;
        add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        # No CSP — GoAccess needs unsafe-inline, unsafe-eval, data: fonts.
        # Not worth maintaining a permissive CSP for a single auth-protected page.

        try_files $uri $uri/ $uri/index.html =404;
    }

    # --- Custom 404 page ---
    error_page 404 /404.html;
    location = /404.html {
        internal;
    }

    # --- Static files with clean URLs ---
    # Try exact path, then path/, then path/index.html, then 404
    location / {
        try_files $uri $uri/ $uri/index.html =404;
    }

    # Cache static assets (re-declare security headers — nginx add_header
    # in a location block replaces ALL parent-level headers)
    location ~* \.(css|js|png|jpg|jpeg|gif|ico|svg|woff2?|pdf)$ {
        expires 7d;
        add_header Cache-Control              "public, immutable"    always;
        add_header X-Content-Type-Options     "nosniff"              always;
        add_header X-Frame-Options            "DENY"                 always;
        add_header Referrer-Policy            "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy         "camera=(), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy    "default-src 'none'; style-src 'self'; font-src 'self'; img-src 'self' data:; frame-ancestors 'none'" always;
        add_header Strict-Transport-Security  "max-age=63072000; includeSubDomains" always;
    }
}
