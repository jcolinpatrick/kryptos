#!/usr/bin/env bash
# Pre-push hook: blocks pushes to public remotes (GitHub) that include
# private paths under the 2026-06-11 transparency doctrine.
#
# The repo is a public gift to the Kryptos community, INCLUDING the
# kryptosbot/ multi-agent orchestrator. Exactly four classes stay private:
#   1. .claude/ and any SKILL.md  — precise agent/skill construction
#   2. .env files                 — secrets (API keys)
#   3. reference/, archive/, analysis_runs/ — local-only source material,
#      bulk personal archives, photo corpora (shared photos live on
#      kryptosbot.com, not in git)
#   4. copy/                      — retired snapshot that contained
#      flattened agent definitions
#
# To install: git config core.hooksPath .githooks
# To verify:  git config core.hooksPath  (should print '.githooks')
#
# To override for an intentional push to a PRIVATE remote (e.g. the
# local upstream mirror), use:
#   ALLOW_PRIVATE_PATHS=1 git push <remote> <ref>
# (PUBLISH_KRYPTOSBOT=1 is accepted as a legacy alias.)

set -euo pipefail

remote_name="$1"
remote_url="$2"

# Determine if this is a public remote
is_public=0
case "$remote_url" in
  *github.com*|*github.io*|https://gitlab.com/*|git@gitlab.com:*) is_public=1 ;;
esac

# Private local mirrors are exempt
if [ "$is_public" = "0" ]; then
  exit 0
fi

if [ "${ALLOW_PRIVATE_PATHS:-0}" = "1" ] || [ "${PUBLISH_KRYPTOSBOT:-0}" = "1" ]; then
  echo "WARNING: private-path override active — permitting push." >&2
  exit 0
fi

# Forbidden paths: directory prefixes, plus .env / SKILL.md at any depth.
FORBIDDEN_REGEX='^(\.claude/|copy/|reference/|archive/|analysis_runs/)|(^|/)\.env$|(^|/)SKILL\.md$'

violations=0
zero_sha=0000000000000000000000000000000000000000

while read -r local_ref local_sha remote_ref remote_sha; do
  # Skip deletion pushes
  [ "$local_sha" = "$zero_sha" ] && continue

  # Determine commit range to inspect
  if [ "$remote_sha" = "$zero_sha" ]; then
    # New branch on remote: check all commits not on origin already
    range_args=("$local_sha" "--not" "--remotes=$remote_name")
  else
    range_args=("$remote_sha..$local_sha")
  fi

  # Get path:status touched in this range. We block ADDITIONS and
  # MODIFICATIONS of forbidden paths but ALLOW DELETIONS — deleting a
  # previously-leaked forbidden path is exactly what cleanup does.
  changed_status=$(git log --name-status --pretty=format: "${range_args[@]}" 2>/dev/null \
                   | sort -u | grep -v '^$' || true)

  if [ -z "$changed_status" ]; then
    continue
  fi

  matches=$(echo "$changed_status" | awk -F'\t' -v re="$FORBIDDEN_REGEX" '
    {
      op = $1
      sub(/[0-9]+$/, "", op)  # strip "100" off "R100" etc.
      if (op == "D") next     # deletion of forbidden path is allowed
      path = (op == "R" || op == "C") ? $3 : $2
      if (path ~ re) print op "\t" path
    }
  ')

  if [ -n "$matches" ]; then
    echo "" >&2
    echo "PRE-PUSH BLOCK: refusing to push to $remote_name ($remote_url)" >&2
    echo "Push includes private paths:" >&2
    echo "$matches" | head -20 | sed 's/^/  - /' >&2
    extra=$(echo "$matches" | tail -n +21)
    if [ -n "$extra" ]; then
      echo "  ...and $(echo "$extra" | wc -l) more" >&2
    fi
    violations=$((violations + 1))
  fi
done

if [ "$violations" -gt 0 ]; then
  echo "" >&2
  echo "Private classes: .claude/ + SKILL.md (agent/skill construction)," >&2
  echo ".env (secrets), reference|archive|analysis_runs (local-only), copy/." >&2
  echo "Remove those paths from the outgoing commits, or for a private" >&2
  echo "remote only: ALLOW_PRIVATE_PATHS=1 git push $remote_name <ref>" >&2
  echo "" >&2
  exit 1
fi

# Content-pattern scan: catches sensitive terminology in *public-path*
# files (the leak class that the path filter above misses). Only runs for
# pushes to public remotes — private mirrors are exempt the same way the
# path check above is.
REPO_ROOT="$(git rev-parse --show-toplevel)"
SCANNER="$REPO_ROOT/ops/publish/scan_content.sh"
if [ -x "$SCANNER" ]; then
  content_violations=0
  while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero_sha" ] && continue
    if [ "$remote_sha" = "$zero_sha" ]; then
      range="$local_sha --not --remotes=$remote_name"
    else
      range="$remote_sha..$local_sha"
    fi
    if ! "$SCANNER" --commits $range; then
      content_violations=$((content_violations + 1))
    fi
  done
  if [ "$content_violations" -gt 0 ]; then
    echo "" >&2
    echo "PRE-PUSH BLOCK: content scan flagged sensitive terms (see above)." >&2
    exit 1
  fi
fi

exit 0
