#!/usr/bin/env bash
# Pre-push hook: blocks pushes to public remotes (GitHub) that include
# proprietary paths (kryptosbot/ and its cross-import dependents).
#
# To install: git config core.hooksPath .githooks
# To verify:  git config core.hooksPath  (should print '.githooks')
#
# To override for an intentional push to a PRIVATE remote (e.g. the
# local upstream mirror), use:
#   PUBLISH_KRYPTOSBOT=1 git push <remote> <ref>
#
# This hook is a structural protection. It exists because the
# kryptosbot/ multi-agent orchestrator is proprietary IP (per
# `feedback_kryptosbot_gitignored_by_design.md` — note: kryptosbot/
# is tracked in git locally but MUST NOT reach public GitHub).

set -euo pipefail

remote_name="$1"
remote_url="$2"

# Determine if this is a public remote
is_public=0
case "$remote_url" in
  *github.com*|*github.io*|https://gitlab.com/*|git@gitlab.com:*) is_public=1 ;;
esac

# Private local mirrors are exempt
if [ "$is_public" = "0" ]; then
  exit 0
fi

if [ "${PUBLISH_KRYPTOSBOT:-0}" = "1" ]; then
  echo "WARNING: PUBLISH_KRYPTOSBOT=1 override active — permitting kryptosbot push." >&2
  exit 0
fi

# Forbidden path prefixes (anchored regex — '^' added below)
FORBIDDEN_REGEX='^(kryptosbot/|scripts/_infra/calibrate_null_baselines|tests/test_polybius_scorer\.py$|tests/test_kryptosbot_oracle_hardening\.py$|tests/test_historical_eliminations\.py$|docs/maturation/phase_|docs/maturation/round2/|docs/maturation/round3/phase_R3|docs/maturation/round3/CLAUDE_CODE_BRIEF|docs/maturation/round3/CURRENT_WORKER_PATH|docs/maturation/round3/DSL_CUTOVER_CONTRACT|docs/maturation/round3/SUMMARY\.md$|docs/maturation/SUMMARY\.md$|docs/maturation/round3/K4_CAMPAIGN_|docs/maturation/round3/K4_RUN_|docs/maturation/round3/K4_SYNTHETIC_)'

violations=0
zero_sha=0000000000000000000000000000000000000000

while read -r local_ref local_sha remote_ref remote_sha; do
  # Skip deletion pushes
  [ "$local_sha" = "$zero_sha" ] && continue

  # Determine commit range to inspect
  if [ "$remote_sha" = "$zero_sha" ]; then
    # New branch on remote: check all commits not on origin already
    range_args=("$local_sha" "--not" "--remotes=$remote_name")
  else
    range_args=("$remote_sha..$local_sha")
  fi

  # Get path:status touched in this range. We block ADDITIONS and
  # MODIFICATIONS of forbidden paths but ALLOW DELETIONS — deleting a
  # previously-leaked forbidden path is exactly what publish-cleanup does.
  # `git log --name-status` prefixes each path with one of: A (added),
  # M (modified), D (deleted), R (renamed), C (copied).
  changed_status=$(git log --name-status --pretty=format: "${range_args[@]}" 2>/dev/null \
                   | sort -u | grep -v '^$' || true)

  if [ -z "$changed_status" ]; then
    continue
  fi

  # Keep only non-deletion operations on forbidden paths.
  # Lines look like:  "A\tkryptosbot/foo.py"  or  "M\tdocs/maturation/round3/phase_R3_01.md"
  # Deletions look like: "D\tkryptosbot/foo.py" — these are PERMITTED.
  # Renames look like "R100\told\tnew" — we treat the new path's prefix as relevant.
  matches=$(echo "$changed_status" | awk -F'\t' -v re="$FORBIDDEN_REGEX" '
    {
      op = $1
      sub(/[0-9]+$/, "", op)  # strip "100" off "R100" etc.
      if (op == "D") next     # deletion of forbidden path is allowed
      # For renames the new path is in $3
      path = (op == "R" || op == "C") ? $3 : $2
      if (path ~ re) print op "\t" path
    }
  ')

  if [ -n "$matches" ]; then
    echo "" >&2
    echo "PRE-PUSH BLOCK: refusing to push to $remote_name ($remote_url)" >&2
    echo "Push includes proprietary paths:" >&2
    echo "$matches" | head -20 | sed 's/^/  - /' >&2
    extra=$(echo "$matches" | tail -n +21)
    if [ -n "$extra" ]; then
      echo "  ...and $(echo "$extra" | wc -l) more" >&2
    fi
    violations=$((violations + 1))
  fi
done

if [ "$violations" -gt 0 ]; then
  echo "" >&2
  echo "To publish only public-safe changes, use:" >&2
  echo "  ops/publish/publish_to_github.sh" >&2
  echo "" >&2
  echo "To intentionally push proprietary content (private remote only):" >&2
  echo "  PUBLISH_KRYPTOSBOT=1 git push $remote_name <ref>" >&2
  echo "" >&2
  exit 1
fi

exit 0
