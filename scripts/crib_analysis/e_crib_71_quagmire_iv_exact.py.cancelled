#!/usr/bin/env python3
"""
Cipher: Quagmire IV (two independent free mixed alphabets, periodic key)
Family: crib_analysis
Status: active
Keyspace: exact -- all 26! x 26! alphabet pairs x all keys, periods 1-30, solved over Z_26
Last run: 2026-08-25
Best score: n/a (deductive closure test, not a scoring sweep)
"""
from __future__ import annotations

_DOC = """QUAGMIRE IV, solved exactly over Z_26 -- two independent free mixed alphabets.

    Quagmire IV      pi_c(c_i)  -  pi_p(p_i)  -  k[r_i]  =  0        (vig)
                     pi_c(c_i)  +  pi_p(p_i)  -  k[r_i]  =  0        (beau)
                    -pi_c(c_i)  +  pi_p(p_i)  -  k[r_i]  =  0        (vbeau)

    r_i = (crib position) mod P,  unknowns = 26 (pi_p) + 26 (pi_c) + P (key).

WHY EXACT SOLVING AND NOT ENUMERATION
-------------------------------------
pi_p and pi_c are 26 unknowns each over Z_26, not keywords out of a list.  A
contradiction therefore closes ALL 26! x 26! alphabet pairs at once for that
period; no enumeration can do that.  Z_26 is not a field, so every system is
solved mod 2 and mod 13 by Gaussian elimination and recombined by CRT
(scripts/lib/z26_linear.py).

WHAT ACTUALLY DECIDES ANYTHING
------------------------------
The system is HOMOGENEOUS: every right-hand side is zero, so pi_p = pi_c =
const, k = 0 is always a solution and `solve_z26` can never return None.
"Linearly consistent" for this family is a THEOREM, not a measurement, and is
reported here only to make that vacuity quantitative.  The entire filter is:

    does the affine solution space contain a point at which pi_p is injective
    AND pi_c is injective?

which is decided soundly (True / False / INCONCLUSIVE, never a sample) by
`injective_point_report`.  Only letters occurring in the cribs are constrained;
letters occurring in no equation are free columns, so once the constrained slots
are pairwise distinct the remaining letters absorb the leftover values.  That
precondition is checked, not assumed.

SATURATION.  Unknowns 52 + P against E equations, so the system is
underdetermined whenever P > E - 52.  At L0 (E = 24) that is EVERY period
including P = 1: the nominal deficit is at least 28 dimensions before a single
rank collapse.  Q4 is expected to be structurally unfilterable almost
everywhere, and reporting that plainly is the point of this script -- not
manufacturing eliminations.

CONTROLS (all mandatory, all reported)
--------------------------------------
 1. POSITIVE CONTROL   synthesise CT from two KNOWN random mixed alphabets, a
                       known key and a known period, for all three variants;
                       the planted point must lie in the space and injectivity
                       must be True.  A test that over-eliminates is worthless.
 2. REAL-DATA CONTROL  K1 (Quagmire III, PALIMPSEST, P=10) and K2 (ABSCISSA,
                       P=8) pushed through the Q4 solver.  Q4 generalises Q3
                       (pi_p = pi_c), so the true KRYPTOS-alphabet point must be
                       in the Q4 space at the true period and injectivity must
                       be True.  The Q3 surviving-period set is printed beside
                       the Q4 one to quantify how much power the second free
                       alphabet destroys.
 3. MATCHED NULL       every surviving cell is re-run, whole procedure
                       including the injectivity search, on shuffled K4
                       ciphertexts.  Sampling is not a null for a search, so
                       the null runs the identical decider.

EPISTEMICS.  "contradicted" = sound elimination for every key and every pair of
alphabets at that period/variant/level.  "consistent" = NOT ELIMINATED; it is
never "possible" and never a candidate.  Budget exhaustion is INCONCLUSIVE.
L0_released is the only EVIDENCE crib level; L1-L5 are hypothesised, so every
statement at those levels is CONDITIONAL and labelled so.

Usage
    PYTHONPATH=src python3 -u scripts/crib_analysis/e_crib_71_quagmire_iv_exact.py \
        [--max-period 30] [--nulls 200] [--workers N] [--out results/...json]
"""
import argparse
import itertools
import json
import math
import os
import random
import sys
import time
from collections import defaultdict
from multiprocessing import Pool

_ROOT = os.path.dirname(os.path.abspath(__file__))
while not os.path.exists(os.path.join(_ROOT, "src")):
    _ROOT = os.path.dirname(_ROOT)
sys.path.insert(0, os.path.join(_ROOT, "src"))
sys.path.insert(0, os.path.join(_ROOT, "scripts", "lib"))
sys.path.insert(0, _ROOT)
sys.path.insert(0, os.path.join(_ROOT, "kryptosbot"))

from kryptos.kernel.constants import CT as K4_CT  # noqa: E402
import crib_sets  # noqa: E402
from z26_linear import (  # noqa: E402
    Z26Space,
    free_columns,
    injective_point_report,
    solve_z26,
)

STD = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
KRY = "KRYPTOSABCDEFGHIJLMNQUVWXZ"
VARIANTS = ("vig", "beau", "vbeau")

# ---------------------------------------------------------------- system builder


def _variant_coeffs(variant: str) -> tuple[int, int]:
    """(coefficient on pi_c, coefficient on pi_p) for the three additive forms."""
    if variant == "vig":        # pi_c - pi_p - k = 0
        return 1, 25
    if variant == "beau":       # pi_c + pi_p - k = 0
        return 1, 1
    if variant == "vbeau":      # -pi_c + pi_p - k = 0
        return 25, 1
    raise ValueError(variant)


def q4_rows(ct: str, cribs: dict[int, str], period: int, variant: str):
    """Rows of the FULL Q4 crib system.  Unknowns 0..25 = pi_p, 26..51 = pi_c, 52.. = k.

    `cribs` maps a 0-indexed position to its plaintext letter; ct[pos] is the
    ciphertext letter there.  RHS is identically zero (the family is homogeneous).
    """
    n = 52 + period
    a_c, a_p = _variant_coeffs(variant)
    rows: list[list[int]] = []
    for pos in sorted(cribs):
        row = [0] * n
        ci, pi_ = 26 + ord(ct[pos]) - 65, ord(cribs[pos]) - 65
        row[ci] = (row[ci] + a_c) % 26
        row[pi_] = (row[pi_] + a_p) % 26
        row[52 + pos % period] = 25
        rows.append(row)
    return rows, [0] * len(rows), n


def q4_rows_reduced(ct: str, cribs: dict[int, str], period: int, variant: str):
    """The same system with the columns that appear in NO equation deleted.

    Sound and lossless: a column with an all-zero coefficient vector is a free
    column, so the full solution space is exactly (this reduced space) x
    Z_26^(dropped columns).  The achievable tuples of values on the surviving
    columns are therefore identical, and injectivity of the constrained slots --
    the only question asked -- is decided on exactly the same set.  Deleting
    them just makes the affine algebra smaller.  `check_reduction_matches_full`
    verifies the equivalence empirically on real cells as well.

    Returns (rows, rhs, n, groups) where groups = [pi_p slots, pi_c slots] in the
    reduced numbering.
    """
    a_c, a_p = _variant_coeffs(variant)
    p_letters = sorted({ord(cribs[q]) - 65 for q in cribs})
    c_letters = sorted({ord(ct[q]) - 65 for q in cribs})
    residues = sorted({q % period for q in cribs})
    col_p = {v: i for i, v in enumerate(p_letters)}
    col_c = {v: len(col_p) + i for i, v in enumerate(c_letters)}
    col_k = {v: len(col_p) + len(col_c) + i for i, v in enumerate(residues)}
    n = len(col_p) + len(col_c) + len(col_k)
    rows: list[list[int]] = []
    for pos in sorted(cribs):
        row = [0] * n
        ci, pi_ = col_c[ord(ct[pos]) - 65], col_p[ord(cribs[pos]) - 65]
        row[ci] = (row[ci] + a_c) % 26
        row[pi_] = (row[pi_] + a_p) % 26
        row[col_k[pos % period]] = 25
        rows.append(row)
    groups = [list(col_p.values()), list(col_c.values())]
    return rows, [0] * len(rows), n, groups


def q3_rows(ct: str, cribs: dict[int, str], period: int, variant: str):
    """Quagmire III: one shared alphabet.  Unknowns 0..25 = pi, 26.. = k."""
    n = 26 + period
    a_c, a_p = _variant_coeffs(variant)
    rows: list[list[int]] = []
    for pos in sorted(cribs):
        row = [0] * n
        ci, pi_ = ord(ct[pos]) - 65, ord(cribs[pos]) - 65
        row[ci] = (row[ci] + a_c) % 26
        row[pi_] = (row[pi_] + a_p) % 26
        row[26 + pos % period] = 25
        rows.append(row)
    return rows, [0] * len(rows), n


def q4_slots(ct: str, cribs: dict[int, str]):
    """The two injectivity groups in FULL numbering: constrained pi_p and pi_c slots."""
    pset = sorted({ord(cribs[q]) - 65 for q in cribs})
    cset = sorted({26 + ord(ct[q]) - 65 for q in cribs})
    return [pset, cset]


# ---------------------------------------------------------------- one cell


def eval_q4(ct, cribs, period, variant, *, node_budget=200_000, restarts=1, seed=0,
            presample=4000, full=False):
    """Decide one (level, period, variant) cell.  Returns a plain dict.

    TWO-STAGE DECIDER, both stages sound:

      stage 1 (cheap, can only say CONSISTENT).  Draw `presample` points from the
              EXACT solution space -- `Z26Space.random_point` is a uniform draw
              over the real parametrisation, not an approximation of it -- and
              check the two groups for pairwise distinctness.  A hit is a
              verified witness, so the cell is consistent and we stop.  A miss
              proves nothing and we fall through.
      stage 2 (complete, can say CONTRADICTED).  `injective_point_report`, whose
              False is a completed depth-first search and whose None is a budget
              exhaustion, i.e. INCONCLUSIVE.

    Stage 1 exists because the depth-first search is slow exactly where witnesses
    are plentiful (L0 periods 13 and 19 burn 300k nodes and still time out, while
    sampling finds a witness in a few thousand draws).  It changes runtime, never
    a verdict: every "consistent" is a verified witness either way, and every
    "contradicted" still comes from the complete search.  The matched null runs
    this identical two-stage procedure, sampling included.

    `full=True` runs the untrimmed 52+P-unknown system instead of the reduced one;
    the two must agree, which `check_reduction_matches_full` asserts.
    """
    if full:
        rows, rhs, n = q4_rows(ct, cribs, period, variant)
        groups = q4_slots(ct, cribs)
    else:
        rows, rhs, n, groups = q4_rows_reduced(ct, cribs, period, variant)
    space = solve_z26(rows, rhs, n)
    if space is None:                       # cannot happen: homogeneous system
        return {"status": "contradicted", "reason": "linear system inconsistent",
                "n_eq": len(rows), "n_unknowns_reduced": n}
    base = {
        "n_eq": len(rows),
        "n_unknowns_full": 52 + period,
        "n_unknowns_reduced": n,
        "rank2": n - space.dim2,
        "rank13": n - space.dim13,
        "dim2": space.dim2,
        "dim13": space.dim13,
        "solution_dim": space.dim2 + space.dim13,
        "log26_size": round(math.log(space.size, 26), 3),
        "n_slots_p": len(groups[0]),
        "n_slots_c": len(groups[1]),
    }
    if presample:
        # deterministic across processes: no str hashing (PYTHONHASHSEED is random)
        rng = random.Random(((seed * 1000003) + period * 101
                             + VARIANTS.index(variant) * 7 + len(rows) * 31) & 0x7FFFFFFF)
        for i in range(presample):
            x = space.random_point(rng)
            if all(len({x[j] for j in g}) == len(g) for g in groups):
                base.update(status="consistent",
                            reason=f"witness found by sampling the exact solution "
                                   f"space at draw {i + 1} and verified",
                            stage=1, samples=i + 1, nodes=0, witness_ok=True,
                            diff_rank2=None, diff_rank13=None, n_pairs=None)
                return base
    rep = injective_point_report(space, groups, 26,
                                 node_budget=node_budget, restarts=restarts, seed=seed)
    status = {True: "consistent", False: "contradicted", None: "inconclusive"}[rep.decision]
    base.update(status=status, reason=rep.reason, stage=2, samples=presample,
                diff_rank2=rep.diff_rank2, diff_rank13=rep.diff_rank13,
                n_pairs=rep.n_pairs, nodes=rep.nodes,
                witness_ok=rep.decision is True and rep.witness is not None)
    return base


def check_reduction_matches_full(ct, cribs_by_level, periods, variants):
    """Cross-check: the trimmed system and the untrimmed 52+P system must return
    the same status on every sampled cell.  Any disagreement voids the sweep."""
    bad = []
    checked = 0
    for lv, cribs in cribs_by_level.items():
        for p in periods:
            for v in variants:
                a = eval_q4(ct, cribs, p, v)["status"]
                b = eval_q4(ct, cribs, p, v, full=True)["status"]
                checked += 1
                if a != b:
                    bad.append({"level": lv, "period": p, "variant": v,
                                "reduced": a, "full": b})
    return {"checked": checked, "mismatches": bad}


def eval_q3(ct, cribs, period, variant, *, node_budget=200_000, restarts=8, seed=0):
    rows, rhs, n = q3_rows(ct, cribs, period, variant)
    space = solve_z26(rows, rhs, n)
    if space is None:
        return "contradicted"
    slots = sorted({ord(cribs[q]) - 65 for q in cribs} | {ord(ct[q]) - 65 for q in cribs})
    rep = injective_point_report(space, slots, 26,
                                 node_budget=node_budget, restarts=restarts, seed=seed)
    return {True: "consistent", False: "contradicted", None: "inconclusive"}[rep.decision]


# ---------------------------------------------------------------- contradiction audit


def audit_contradiction(ct, cribs, period, variant, samples=2000, seed=7):
    """INDEPENDENT corroboration of a `contradicted` cell, not a re-run of the decider.

    (a) Forced-pair route.  If the decider reported a pair of slots equal at every
        point, re-derive that WITHOUT the injectivity code: append the single
        equation x[s] - x[t] = d and solve; if the system is inconsistent for all
        25 nonzero d, then x[s] = x[t] on the whole space, which is a proof by
        Gaussian elimination alone (and `gauss_mod_p` was validated against brute
        force).
    (b) Sampling route.  Draw random points of the exact solution space and check
        that none is injective.  This CORROBORATES, it does not prove -- the proof
        is the completed search inside the decider.  It exists to catch a wiring
        bug, e.g. slot indices pointing at the wrong columns.
    """
    rows, rhs, n, groups = q4_rows_reduced(ct, cribs, period, variant)
    space = solve_z26(rows, rhs, n)
    if space is None:
        return {"route": "linear", "proved": True}
    rep = injective_point_report(space, groups, 26)
    out = {"decision": rep.decision, "reason": rep.reason, "forced_pair_proved": None}
    if rep.decision is not False:
        return out
    if "equal at every point" in rep.reason:
        st = [int(x) for x in rep.reason.replace("slots", "").split("are")[0].split("and")]
        s_, t_ = st[0], st[1]
        row = [0] * n
        row[s_], row[t_] = 1, 25
        infeasible = all(solve_z26(rows + [row], rhs + [d], n) is None for d in range(1, 26))
        out["forced_pair"] = [s_, t_]
        out["forced_pair_proved"] = infeasible
    rng = random.Random(seed)
    inj = 0
    for _ in range(samples):
        x = space.random_point(rng)
        if all(len({x[i] for i in g}) == len(g) for g in groups):
            inj += 1
    out["random_points_sampled"] = samples
    out["random_points_injective"] = inj
    return out


def independent_forced_collisions(ct, cribs, period, variant="vig"):
    """SECOND IMPLEMENTATION, sharing no code with z26_linear.

    A weighted union-find over the exact integers mod 26 that only ever uses the
    TWO-TERM consequences of the crib relations.  Inside one residue class every
    crib satisfies  a_c*pi_c(c) + a_p*pi_p(p) = k[r], so two cribs there with the
    same ciphertext letter force  pi_p(p1) = pi_p(p2), and two with the same
    plaintext letter force  pi_c(c1) = pi_c(c2); those equalities then propagate
    transitively.  A forced equality between DISTINCT letters means no injective
    alphabet exists, with no linear algebra and no search involved.

    This is deliberately WEAKER than the exact solver: it sees only first-order
    forcings, so it can miss a contradiction the solver proves.  Its job is to
    catch a wiring bug in the solver path, not to decide cells.  Returns the list
    of forced (group, letter1, letter2) collisions it can see.
    """
    from collections import defaultdict
    par: dict = {}
    off: dict = {}

    def find(x):
        par.setdefault(x, x)
        off.setdefault(x, 0)
        if par[x] == x:
            return x, 0
        r, o = find(par[x])
        par[x] = r
        off[x] = (off[x] + o) % 26
        return r, off[x]

    def union(a, b, d):
        ra, oa = find(a)
        rb, ob = find(b)
        if ra == rb:
            return ((oa - ob) % 26) == d % 26
        par[ra] = rb
        off[ra] = (ob + d - oa) % 26
        return True

    byr = defaultdict(list)
    for pos in sorted(cribs):
        byr[pos % period].append((ct[pos], cribs[pos]))
    for _r, prs in byr.items():
        for i in range(len(prs)):
            for j in range(i + 1, len(prs)):
                ci, pi_ = prs[i]
                cj, pj = prs[j]
                if ci == cj and pi_ != pj:
                    union(("p", pi_), ("p", pj), 0)
                if pi_ == pj and ci != cj:
                    union(("c", ci), ("c", cj), 0)
    coll = []
    for typ in ("p", "c"):
        seen: dict = {}
        for node in list(par):
            if node[0] != typ:
                continue
            r, o = find(node)
            if (r, o) in seen:
                coll.append((typ, seen[(r, o)], node[1]))
            else:
                seen[(r, o)] = node[1]
    return coll


def cross_check_independent(ct, cribs_by_level, max_period, variants):
    """Every cell where the independent union-find sees a forced collision MUST be
    reported contradicted by the exact solver.  The converse is not required (the
    solver is strictly stronger); the gap is reported so the extra power is visible."""
    agree = disagree = solver_only = 0
    bad = []
    for lv, cribs in cribs_by_level.items():
        for p_ in range(1, max_period + 1):
            for v in variants:
                uf = bool(independent_forced_collisions(ct, cribs, p_, v))
                st = eval_q4(ct, cribs, p_, v)["status"]
                if uf and st == "contradicted":
                    agree += 1
                elif uf and st != "contradicted":
                    disagree += 1
                    bad.append({"level": lv, "period": p_, "variant": v, "solver": st})
                elif not uf and st == "contradicted":
                    solver_only += 1
    return {"union_find_forced_and_solver_contradicted": agree,
            "union_find_forced_but_solver_did_not_contradict": disagree,
            "solver_contradicted_beyond_first_order": solver_only,
            "disagreements": bad}


# ---------------------------------------------------------------- graph diagnostics


def graph_stats(ct, cribs, period):
    """Cycle structure of the Q4 constraint hypergraph, and the FIRST-ORDER forcings.

    Vertices: pi_p letters, pi_c letters, k residues.  Each crib is a size-3
    hyperedge.  Forced collisions are what can contradict:
      * two cribs at the same residue with the same CT letter and different PT
        letters force pi_p(p1) = pi_p(p2);
      * same residue, same PT letter, different CT letters force a pi_c collision.
    Longer chains exist and are caught by the linear algebra, not by this count;
    these numbers are diagnostics, never the decision.
    """
    parent: dict = {}

    def find(x):
        parent.setdefault(x, x)
        while parent[x] != x:
            parent[x] = parent[parent[x]]
            x = parent[x]
        return x

    def union(a, b):
        ra, rb = find(a), find(b)
        if ra != rb:
            parent[ra] = rb

    by_res: dict[int, list[tuple[str, str]]] = defaultdict(list)
    for pos in sorted(cribs):
        p_ch, c_ch, r = cribs[pos], ct[pos], pos % period
        by_res[r].append((c_ch, p_ch))
        union(("p", p_ch), ("c", c_ch))
        union(("c", c_ch), ("k", r))

    n_edges = len(cribs)
    verts = set()
    for pos in sorted(cribs):
        verts |= {("p", cribs[pos]), ("c", ct[pos]), ("k", pos % period)}
    comps = len({find(v) for v in verts})
    # first Betti number of the incidence graph (each hyperedge contributes 2 links)
    betti = 2 * n_edges - len(verts) + comps

    forced_p = forced_c = 0
    for r, prs in by_res.items():
        c_to_p, p_to_c = defaultdict(set), defaultdict(set)
        for c_ch, p_ch in prs:
            c_to_p[c_ch].add(p_ch)
            p_to_c[p_ch].add(c_ch)
        forced_p += sum(len(v) - 1 for v in c_to_p.values() if len(v) > 1)
        forced_c += sum(len(v) - 1 for v in p_to_c.values() if len(v) > 1)
    return {"n_vertices": len(verts), "n_edges": n_edges, "n_components": comps,
            "betti": betti, "first_order_forced_pi_p": forced_p,
            "first_order_forced_pi_c": forced_c}


# ---------------------------------------------------------------- controls


def _encrypt_q4(pt, alpha_p, alpha_c, key, variant):
    ip = {ch: i for i, ch in enumerate(alpha_p)}
    out = []
    for i, ch in enumerate(pt):
        k = key[i % len(key)]
        if variant == "vig":
            v = (ip[ch] + k) % 26
        elif variant == "beau":
            v = (k - ip[ch]) % 26
        else:
            v = (ip[ch] - k) % 26
        out.append(alpha_c[v])
    return "".join(out)


def positive_control(trials=12, seed=11):
    """Synthesise from two KNOWN independent alphabets + key + period; the planted
    point must be in the space and injectivity must be True.  Over-elimination
    here would invalidate every negative result in the sweep."""
    rng = random.Random(seed)
    rows_out, passed, total = [], 0, 0
    for t in range(trials):
        for variant in VARIANTS:
            total += 1
            alpha_p = "".join(rng.sample(STD, 26))
            alpha_c = "".join(rng.sample(STD, 26))
            period = rng.randrange(3, 11)
            key = [rng.randrange(26) for _ in range(period)]
            pt = "".join(rng.choice(STD) for _ in range(300))
            ct = _encrypt_q4(pt, alpha_p, alpha_c, key, variant)
            cribs = {i: pt[i] for i in range(len(pt))}
            rr, rhs, n = q4_rows(ct, cribs, period, variant)
            sp = solve_z26(rr, rhs, n)
            ok_space = sp is not None
            ip = {ch: i for i, ch in enumerate(alpha_p)}
            ic = {ch: i for i, ch in enumerate(alpha_c)}
            truth = ([ip[STD[i]] for i in range(26)]
                     + [ic[STD[i]] for i in range(26)] + list(key))
            ok_truth = ok_space and sp.contains(truth)
            rep = (injective_point_report(sp, q4_slots(ct, cribs), 26)
                   if ok_space else None)
            ok_inj = rep is not None and rep.decision is True
            ok = ok_space and ok_truth and ok_inj
            passed += ok
            rows_out.append({"trial": t, "variant": variant, "period": period,
                             "space_nonempty": ok_space, "planted_point_in_space": ok_truth,
                             "injective": ok_inj,
                             "solution_dim": (sp.dim2 + sp.dim13) if ok_space else None,
                             "pass": ok})
    return {"passed": passed, "total": total, "rows": rows_out}


def _rd_job(arg):
    name, ct, pt, p = arg
    cribs = {i: pt[i] for i in range(len(pt))}
    return (name, p,
            eval_q4(ct, cribs, p, "vig")["status"],
            eval_q3(ct, cribs, p, "vig"))


def real_data_control(max_period=20, workers=1):
    """K1 / K2: real solved Quagmire III panels, pushed through BOTH solvers."""
    import compute as C  # kryptosbot/compute.py

    K2_CT = (
        "VFPJUDEEHZWETZYVGWHKKQETGFQJNCEGGWHKKDQMCPFQZDQMMIAGPFXHQRLGTIMVMZJANQLVKQEDAGDVFRPJUNGEUNA"
        "QZGZLECGYUXUEENJTBJLBQCRTBJDFHRRYIZETKZEMVDUFKSJHKFWHKUWQLSZFTIHHDDDUVH"
        "DWKBFUFPWNTDFIYCUQZEREEVLDKFEZMOQQJLTTUGSYQPFEUNLAVIDXFLGGTEZ"
        "FKZBSFDQVGOGIPUFXHHDRKFFHQNTGPUAECNUVPDJMQCLQUMUNEDFQELZZVRRGKFFVOEEXBD"
        "MVPNFQXEZLGREDNQFMPNZGLFLPMRJQYALMGNUVPDXVKPDQUMEBEDMHDAFMJGZNUPLGEWJLLAETG"
    )
    panels = [("K1", C.K1_CT, C.K1_PT, "PALIMPSEST", 10),
              ("K2", K2_CT, C.K2_PT, "ABSCISSA", 8)]
    kidx = {ch: i for i, ch in enumerate(KRY)}
    out = []
    for name, ct, pt, kw, true_p in panels:
        n = min(len(ct), len(pt))
        ct, pt = ct[:n], pt[:n]
        cribs = {i: pt[i] for i in range(n)}
        # true point: pi_p = pi_c = KRYPTOS alphabet, key = keyword in that alphabet
        pi_vec = [kidx[STD[i]] for i in range(26)]
        key = [kidx[ch] for ch in kw]
        truth4 = pi_vec + pi_vec + key
        truth3 = pi_vec + key
        rr, rhs, nn = q4_rows(ct, cribs, true_p, "vig")
        sp4 = solve_z26(rr, rhs, nn)
        rr3, rhs3, n3 = q3_rows(ct, cribs, true_p, "vig")
        sp3 = solve_z26(rr3, rhs3, n3)
        rep4 = injective_point_report(sp4, q4_slots(ct, cribs), 26) if sp4 else None
        # recovered alphabet up to the gauge constant, read off the Q3 witness
        rep3 = None
        recovered = None
        if sp3 is not None:
            slots3 = sorted({ord(pt[i]) - 65 for i in range(n)}
                            | {ord(ct[i]) - 65 for i in range(n)})
            rep3 = injective_point_report(sp3, slots3, 26)
            if rep3.decision is True:
                w = rep3.witness
                shift = (w[ord("A") - 65] - kidx["A"]) % 26
                recovered = all((w[i] - shift) % 26 == pi_vec[i] for i in range(26))
        jobs = [(name, ct, pt, p) for p in range(1, max_period + 1)]
        if workers > 1:
            with Pool(min(workers, len(jobs))) as pool:
                got = pool.map(_rd_job, jobs)
        else:
            got = [_rd_job(j) for j in jobs]
        surv4 = sorted(p for _, p, s4, _ in got if s4 == "consistent")
        surv3 = sorted(p for _, p, _, s3 in got if s3 == "consistent")
        out.append({
            "panel": name, "true_period": true_p, "keyword": kw, "n": n,
            "q4_true_point_in_space": bool(sp4 and sp4.contains(truth4)),
            "q4_injective_at_true_period": rep4.decision if rep4 else None,
            "q3_true_point_in_space": bool(sp3 and sp3.contains(truth3)),
            "q3_injective_at_true_period": rep3.decision if rep3 else None,
            "q3_recovered_KRYPTOS_up_to_gauge": recovered,
            "q4_surviving_periods": surv4,
            "q3_surviving_periods": surv3,
        })
    return out


# ---------------------------------------------------------------- sweep + null

_G: dict = {}


def _init(levels_cribs, max_period, node_budget, restarts, presample):
    _G["cribs"] = levels_cribs
    _G["max_period"] = max_period
    _G["node_budget"] = node_budget
    _G["restarts"] = restarts
    _G["presample"] = presample


def _cell_job(arg):
    level, period, variant = arg
    cribs = _G["cribs"][level]
    r = eval_q4(K4_CT, cribs, period, variant,
                node_budget=_G["node_budget"], restarts=_G["restarts"],
                presample=_G["presample"])
    r.update(level=level, period=period, variant=variant)
    r["graph"] = graph_stats(K4_CT, cribs, period)
    return r


def _shuffled_ct(seed: int) -> str:
    rng = random.Random(seed)
    ct = list(K4_CT)
    rng.shuffle(ct)
    return "".join(ct)


def _null_job(arg):
    """One (shuffled ciphertext, cell) pair through the IDENTICAL decider --
    same solver, same injectivity search, same budget.  Sampling is not a null
    for a search, so nothing here is short-circuited."""
    seed, chunk = arg
    ct = _shuffled_ct(seed)
    out = []
    for level, period, variant in chunk:
        cribs = _G["cribs"][level]
        st = eval_q4(ct, cribs, period, variant,
                     node_budget=_G["node_budget"], restarts=_G["restarts"],
                     presample=_G["presample"], seed=seed)["status"]
        out.append((f"{level}|{period}|{variant}", st))
    return out


# ---------------------------------------------------------------- main


def main() -> int:
    ap = argparse.ArgumentParser(description=_DOC,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--max-period", type=int, default=30)
    ap.add_argument("--nulls", type=int, default=200,
                    help="shuffled ciphertexts for the matched null (0 disables)")
    ap.add_argument("--workers", type=int, default=max(1, (os.cpu_count() or 4) - 2))
    ap.add_argument("--node-budget", type=int, default=200_000)
    ap.add_argument("--restarts", type=int, default=1,
                help="extra randomised passes AFTER a node-budget exhaustion; "
                     "the first pass is already a complete search")
    ap.add_argument("--presample", type=int, default=4000,
                    help="stage-1 draws from the exact solution space per cell")
    ap.add_argument("--levels", default=",".join(crib_sets.LEVELS))
    ap.add_argument("--out", default=os.path.join(_ROOT, "results",
                                                  "crib_quagmire_iv_exact.json"))
    ap.add_argument("--skip-controls", action="store_true")
    args = ap.parse_args()

    levels = [x for x in args.levels.split(",") if x]
    cribs_by_level = {lv: {q: ch for q, ch in crib_sets.level(lv).items()} for lv in levels}

    t0 = time.perf_counter()
    print("=" * 78)
    print("QUAGMIRE IV EXACT CLOSURE SWEEP -- pi_c(c) - pi_p(p) - k[r] = 0 over Z_26")
    print("=" * 78)

    # ---------- structural preamble
    print("\n[0] SATURATION AND VACUITY (structural, before any K4 data)")
    print("    Unknowns = 52 + P.  RHS is identically zero, so the system is")
    print("    HOMOGENEOUS: pi_p = pi_c = const, k = 0 always solves it.  Linear")
    print("    consistency is a theorem here and can never eliminate anything.")
    sat = {}
    for lv in levels:
        E = len(cribs_by_level[lv])
        thr = max(1, E - 52 + 1)
        sat[lv] = {"n_equations": E, "saturation_period": thr,
                   "saturated_everywhere": thr <= 1}
        note = ("saturated at EVERY period" if thr <= 1
                else f"unknowns exceed equations from P >= {thr}")
        print(f"    {lv:<18} E={E:>3}  unknowns 53..{52 + args.max_period}   {note}")

    # ---------- controls
    controls: dict = {}
    if not args.skip_controls:
        print("\n[1] POSITIVE CONTROL -- known alphabets, known key, all three variants")
        pc = positive_control()
        controls["positive"] = pc
        print(f"    {pc['passed']}/{pc['total']} pass "
              f"(planted point in space AND injectivity True). "
              f"{'OK' if pc['passed'] == pc['total'] else 'FAILED -- results below are void'}")
        if pc["passed"] != pc["total"]:
            for r in pc["rows"]:
                if not r["pass"]:
                    print(f"    FAIL {r}")
            return 2

        print("\n[2] REAL-DATA CONTROL -- K1 / K2, published Quagmire III panels")
        rd = real_data_control(max_period=20, workers=args.workers)
        controls["real_data"] = rd
        for r in rd:
            print(f"    {r['panel']}  true period {r['true_period']} ({r['keyword']}), "
                  f"n={r['n']}")
            print(f"        Q3: true point in space={r['q3_true_point_in_space']}  "
                  f"injective={r['q3_injective_at_true_period']}  "
                  f"KRYPTOS recovered up to gauge={r['q3_recovered_KRYPTOS_up_to_gauge']}")
            print(f"        Q4: true point in space={r['q4_true_point_in_space']}  "
                  f"injective={r['q4_injective_at_true_period']}")
            print(f"        surviving periods 1-20   Q3 {r['q3_surviving_periods']}")
            print(f"                                 Q4 {r['q4_surviving_periods']}")

    # ---------- the sweep
    cells = [(lv, p, v) for lv in levels
             for p in range(1, args.max_period + 1) for v in VARIANTS]
    print(f"\n[3] SWEEP -- {len(cells)} cells "
          f"({len(levels)} levels x {args.max_period} periods x {len(VARIANTS)} variants), "
          f"{args.workers} workers")
    with Pool(args.workers, initializer=_init,
              initargs=(cribs_by_level, args.max_period, args.node_budget,
                        args.restarts, args.presample)) as pool:
        results = pool.map(_cell_job, cells, chunksize=2)
    by_key = {f"{r['level']}|{r['period']}|{r['variant']}": r for r in results}

    for lv in levels:
        print(f"\n    {lv}  ({crib_sets.DESCRIPTIONS[lv]})"
              + ("" if lv == "L0_released" else "   [CONDITIONAL on this hypothesis]"))
        for v in VARIANTS:
            row = []
            for p in range(1, args.max_period + 1):
                st = by_key[f"{lv}|{p}|{v}"]["status"]
                row.append({"consistent": ".", "contradicted": "X",
                            "inconclusive": "?"}[st])
            print(f"        {v:<6} P=1..{args.max_period}: {''.join(row)}")
        contr = sorted(p for p in range(1, args.max_period + 1)
                       for v in VARIANTS if by_key[f'{lv}|{p}|{v}']['status'] == 'contradicted')
        print(f"        X = contradicted, . = consistent (NOT eliminated), ? = INCONCLUSIVE"
              f"   |  contradicted cells: {len(set(contr))} distinct periods")

    # ---------- reduction cross-check (the trimmed system must equal the full one)
    print("\n[4] REDUCTION CROSS-CHECK -- trimmed system vs the full 52+P-unknown system")
    chk = check_reduction_matches_full(
        K4_CT, cribs_by_level,
        sorted({1, 2, 3, 5, 7, 8, 11, 13, 17, 19, 23, args.max_period}
               & set(range(1, args.max_period + 1))),
        VARIANTS)
    print(f"    {chk['checked']} cells re-decided on the untrimmed system, "
          f"{len(chk['mismatches'])} mismatches "
          f"{'OK' if not chk['mismatches'] else 'FAILED -- results void'}")
    if chk["mismatches"]:
        for mm in chk["mismatches"][:10]:
            print(f"    MISMATCH {mm}")
        return 3

    # ---------- independent audit of a sample of contradictions
    print("\n[5] CONTRADICTION AUDIT -- independent corroboration, not a re-run")
    audits = []
    contr_cells = [(r["level"], r["period"], r["variant"]) for r in results
                   if r["status"] == "contradicted"]
    rng_a = random.Random(3)
    sample_cells = contr_cells if len(contr_cells) <= 24 else rng_a.sample(contr_cells, 24)
    for lv, p_, v in sorted(sample_cells):
        a = audit_contradiction(K4_CT, cribs_by_level[lv], p_, v)
        a.update(level=lv, period=p_, variant=v)
        audits.append(a)
    n_forced = sum(1 for a in audits if a.get("forced_pair_proved") is True)
    n_forced_bad = sum(1 for a in audits if a.get("forced_pair_proved") is False)
    n_samp_bad = sum(1 for a in audits if a.get("random_points_injective", 0) > 0)
    print(f"    {len(audits)} contradicted cells audited: "
          f"{n_forced} forced-pair contradictions re-proved by Gaussian elimination alone, "
          f"{n_forced_bad} failed that re-proof, "
          f"{n_samp_bad} produced an injective random point (must be 0)")
    if n_forced_bad or n_samp_bad:
        print("    AUDIT FAILED -- eliminations are void")
        return 4

    # ---------- matched null
    null_rates: dict = {}
    surviving = [(r["level"], r["period"], r["variant"]) for r in results
                 if r["status"] == "consistent"]
    if args.nulls and surviving:
        print(f"\n[6] MATCHED NULL -- {args.nulls} shuffled K4 ciphertexts through the "
              f"IDENTICAL procedure\n    (same solver, same injectivity search, same "
              f"budget) on all {len(surviving)} surviving cells "
              f"= {args.nulls * len(surviving)} decisions")
        CH = 6
        jobs = [(1000 + i, surviving[j:j + CH])
                for i in range(args.nulls) for j in range(0, len(surviving), CH)]
        rng_j = random.Random(0)
        rng_j.shuffle(jobs)                       # load balance: mix cheap and dear cells
        with Pool(args.workers, initializer=_init,
                  initargs=(cribs_by_level, args.max_period, args.node_budget,
                            args.restarts, args.presample)) as pool:
            outs = pool.map(_null_job, jobs, chunksize=1)
        counts: dict[str, int] = defaultdict(int)
        incon: dict[str, int] = defaultdict(int)
        for o in outs:
            for k, st in o:
                if st == "consistent":
                    counts[k] += 1
                elif st == "inconclusive":
                    incon[k] += 1
        for lv, p_, v in surviving:
            k = f"{lv}|{p_}|{v}"
            null_rates[k] = counts[k] / args.nulls
        for lv in levels:
            rates = [(p_, v, null_rates[f"{lv}|{p_}|{v}"])
                     for p_ in range(1, args.max_period + 1) for v in VARIANTS
                     if f"{lv}|{p_}|{v}" in null_rates]
            if not rates:
                print(f"    {lv:<18} no surviving cell")
                continue
            vals = sorted(r[2] for r in rates)
            lo = min(rates, key=lambda t: t[2])
            print(f"    {lv:<18} {len(rates):>3} surviving cells; shuffled-CT survival "
                  f"min {vals[0]:.3f}  median {vals[len(vals) // 2]:.3f}  max {vals[-1]:.3f}"
                  f"   (lowest: P={lo[0]} {lo[1]})")
        tot_incon = sum(incon.values())
        if tot_incon:
            print(f"    {tot_incon} null decisions came back INCONCLUSIVE "
                  f"(counted as non-surviving in the rate above, which makes the "
                  f"reported null rate a LOWER bound)")
    for r in results:
        r["shuffled_null_rate"] = null_rates.get(
            f"{r['level']}|{r['period']}|{r['variant']}")

    elapsed = time.perf_counter() - t0
    payload = {
        "script": os.path.relpath(os.path.abspath(__file__), _ROOT),
        "family": "quagmire_iv_exact_z26",
        "equation": "pi_c(c_i) - pi_p(p_i) - k[r_i] = 0 (vig; beau/vbeau negate as documented)",
        "max_period": args.max_period, "variants": list(VARIANTS), "levels": levels,
        "n_nulls": args.nulls, "node_budget": args.node_budget,
        "presample": args.presample, "restarts": args.restarts,
        "saturation": sat, "controls": controls, "cells": results,
        "reduction_crosscheck": chk, "contradiction_audit": audits,
        "elapsed_sec": round(elapsed, 1),
    }
    os.makedirs(os.path.dirname(args.out), exist_ok=True)
    with open(args.out, "w") as fh:
        json.dump(payload, fh, indent=1)
    print(f"\nwrote {args.out}   ({elapsed:.1f}s)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
